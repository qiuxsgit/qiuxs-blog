# Copy to /web/deploy/blog/shared/blog.env on blogweb1; never commit the real file.
# Values below are placeholders. Replace every `change-me` value before starting.
BLOG_ENV=production
BLOG_HTTP_ADDR=:8080
BLOG_MYSQL_HOST=127.0.0.1
BLOG_MYSQL_PORT=3306
BLOG_MYSQL_USER=blog
BLOG_MYSQL_PASSWORD=change-me
BLOG_MYSQL_DATABASE=qiuxs_blog
BLOG_MYSQL_ARGS='parseTime=true&loc=UTC&charset=utf8mb4'
BLOG_REDIS_ADDR=127.0.0.1:6379
BLOG_REDIS_PASSWORD=
BLOG_REDIS_DB=0

# ID lanes. Keep the defaults unless another service already owns this lane.
IDGEN_OFFSET=1
IDGEN_STEP=1
IDGEN_HEAL=false

BLOG_ADMIN_ORIGIN=https://blog-admin.qiuxs.com
BLOG_SESSION_COOKIE_NAME=qx_blog_session
BLOG_SESSION_TTL=24h

BLOG_GFS_BASE_URL=https://gfs.example.com
BLOG_GFS_APP_DOMAIN=change-me
BLOG_GFS_APP_ID=change-me
BLOG_GFS_APP_SECRET=change-me
BLOG_GFS_PUBLIC_READ_SECRET=change-me

# Generate the first two with: openssl rand -hex 32
BLOG_BUNDLE_TOKEN=change-me-change-me-change-me-change-me
BLOG_CALLBACK_HMAC_KEY=change-me-change-me-change-me-change-me

# Generate with: openssl rand 32 | base64 | tr -d '\n='
# Must be unpadded Raw-Std-Base64 encoding of exactly 32 bytes.
BLOG_BUILDER_MASTER_KEY=change-me

# This file must be visible from blogweb1. If the site host is separate,
# arrange for Jenkins to copy the deployed release.json to this path.
BLOG_CURRENT_RELEASE_JSON_PATH=/web/deploy/blog/shared/release.json
