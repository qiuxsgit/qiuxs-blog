---
import '../styles/global.css';
import {loadBundle} from '../lib/bundle';
const bundle=await loadBundle(); const {title=''}=Astro.props; const canonical=new URL(Astro.url.pathname,'https://qiuxs.com').toString();
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title ? `${title} · ${bundle.site.name}` : bundle.site.name}</title><meta name="description" content={Astro.props.description ?? bundle.site.authorBio}/><link rel="canonical" href={canonical}/><meta property="og:title" content={title || bundle.site.name}/><meta property="og:description" content={Astro.props.description ?? bundle.site.authorBio}/><meta property="og:url" content={canonical}/><meta name="twitter:card" content="summary_large_image"/><script is:inline>try{document.documentElement.dataset.theme=localStorage.theme||'light'}catch(e){}</script></head><body><header><div class="wrap"><nav><a class="brand" href="/">{bundle.site.name}</a><a href="/posts/">文章</a><a href="/tags/">标签</a><a href="/archive/">归档</a><a href="/about/">关于</a><button id="theme-toggle" type="button" aria-label="切换主题">◐</button></nav></div></header><main><div class="wrap"><slot/></div></main><footer><div class="wrap">© {new Date().getFullYear()} {bundle.site.name} · <a href="https://beian.miit.gov.cn/" rel="noopener">{bundle.site.filingName} {bundle.site.filingNumber}</a></div></footer><script is:inline>document.querySelector('#theme-toggle')?.addEventListener('click',()=>{const d=document.documentElement;const t=d.dataset.theme==='dark'?'light':'dark';d.dataset.theme=t;localStorage.theme=t})</script></body></html>
