---
import Base from '../../layouts/BaseLayout.astro'; import {loadBundle} from '../../lib/bundle'; import {buildContentIndex} from '../../lib/content'; import {renderMarkdown} from '../../lib/markdown';
export async function getStaticPaths(){const b=await loadBundle(); return b.articles.map(article=>({params:{slug:article.slug},props:{article,b}}));} const {article,b}=Astro.props; const content=await renderMarkdown(article.contentMarkdown); const index=buildContentIndex(b);
---
<Base title={article.title} description={article.summary}><article class="article"><div class="eyebrow">ARTICLE</div><h1>{article.title}</h1><p class="meta">{new Date(article.publishedAt).toLocaleDateString('zh-CN')} · {content.wordCount} 字 · {content.readingMinutes} 分钟</p><div class="tags">{article.tags.map((t:string)=><a class="tag" href={`/tags/${t}/`}>#{t}</a>)}</div><hr/><div set:html={content.html}/><nav aria-label="相邻文章"><div>{index.previous(article.slug)&&<a href={`/posts/${index.previous(article.slug)!.slug}/`}>← {index.previous(article.slug)!.title}</a>}</div><div>{index.next(article.slug)&&<a href={`/posts/${index.next(article.slug)!.slug}/`}>{index.next(article.slug)!.title} →</a>}</div></nav></article></Base>
